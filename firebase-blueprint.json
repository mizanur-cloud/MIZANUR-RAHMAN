{
  "entities": {
    "AdminAccount": {
      "title": "AdminAccount",
      "description": "An approved school routine administrator managed exclusively by the Super Admin.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Deterministic email-derived document ID"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "designation": {
          "type": "string",
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "enum": ["admin"]
        },
        "status": {
          "type": "string",
          "enum": ["active", "paused", "blocked"]
        },
        "statusReason": {
          "type": "string",
          "maxLength": 300
        },
        "uid": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdByEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "lastLoginAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "email", "name", "role", "status", "createdAt", "updatedAt", "createdByEmail"]
    },
    "RoutineMetadata": {
      "title": "RoutineMetadata",
      "description": "Published classes, subjects, bell/school settings, and public teacher display data (PII stripped).",
      "type": "object",
      "properties": {
        "classes": {
          "type": "array"
        },
        "teachers": {
          "type": "array"
        },
        "subjects": {
          "type": "array"
        },
        "settings": {
          "type": "object"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedByEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "updatedByName": {
          "type": "string",
          "maxLength": 100
        }
      },
      "required": ["classes", "teachers", "subjects", "settings", "updatedAt", "updatedByEmail", "updatedByName"]
    },
    "RoutineSchedule": {
      "title": "RoutineSchedule",
      "description": "Published weekly timetable period assignments across all classes and sections.",
      "type": "object",
      "properties": {
        "entries": {
          "type": "array"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedByEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "updatedByName": {
          "type": "string",
          "maxLength": 100
        }
      },
      "required": ["entries", "updatedAt", "updatedByEmail", "updatedByName"]
    },
    "StaffContactsDoc": {
      "title": "StaffContactsDoc",
      "description": "Private faculty contact info (emails and phone numbers) isolated from public viewers.",
      "type": "object",
      "properties": {
        "contacts": {
          "type": "object"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedByEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        }
      },
      "required": ["contacts", "updatedAt", "updatedByEmail"]
    },
    "AuditLogEntry": {
      "title": "AuditLogEntry",
      "description": "Immutable activity and security audit log entry.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "action": {
          "type": "string",
          "enum": [
            "routine_update",
            "routine_generate",
            "routine_autofix",
            "routine_import",
            "routine_reset",
            "class_update",
            "teacher_update",
            "subject_update",
            "settings_update",
            "annual_plan_update",
            "proxy_assigned",
            "proxy_updated",
            "proxy_deleted",
            "admin_added",
            "admin_paused",
            "admin_blocked",
            "admin_activated",
            "admin_removed"
          ]
        },
        "targetSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "actorEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "actorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "actorRole": {
          "type": "string",
          "enum": ["super_admin", "admin"]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "action", "targetSummary", "actorEmail", "actorName", "actorRole", "timestamp"]
    },
    "ProxyLogEntry": {
      "title": "ProxyLogEntry",
      "description": "Recorded proxy class assignment log entry accessible only to active admins and Super Admin.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 160, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "date": { "type": "string", "maxLength": 10 },
        "day": { "type": "string", "enum": ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"] },
        "periodIndex": { "type": "integer", "minimum": 1, "maximum": 12 },
        "periodLabel": { "type": "string", "maxLength": 60 },
        "periodTime": { "type": "string", "maxLength": 60 },
        "classId": { "type": "string", "maxLength": 100 },
        "className": { "type": "string", "maxLength": 100 },
        "sectionId": { "type": "string", "maxLength": 100 },
        "sectionName": { "type": "string", "maxLength": 100 },
        "subjectId": { "type": "string", "maxLength": 100 },
        "subjectName": { "type": "string", "maxLength": 120 },
        "subjectColor": { "type": "string", "maxLength": 30 },
        "absentTeacherId": { "type": "string", "maxLength": 100 },
        "absentTeacherName": { "type": "string", "maxLength": 120 },
        "proxyTeacherId": { "type": "string", "maxLength": 100 },
        "proxyTeacherName": { "type": "string", "maxLength": 120 },
        "assignedByEmail": { "type": "string", "format": "email", "maxLength": 160 },
        "assignedByName": { "type": "string", "maxLength": 100 },
        "assignedByRole": { "type": "string", "enum": ["super_admin", "admin"] },
        "status": { "type": "string", "enum": ["assigned", "completed", "cancelled"] },
        "room": { "type": "string", "maxLength": 80 },
        "matchType": { "type": "string", "enum": ["same_subject", "same_department", "free_teacher", "manual"] },
        "matchReason": { "type": "string", "maxLength": 200 },
        "overriddenWarning": { "type": "string", "maxLength": 400 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "date",
        "day",
        "periodIndex",
        "periodLabel",
        "periodTime",
        "classId",
        "className",
        "sectionId",
        "sectionName",
        "subjectId",
        "subjectName",
        "absentTeacherId",
        "absentTeacherName",
        "proxyTeacherId",
        "proxyTeacherName",
        "assignedByEmail",
        "assignedByName",
        "assignedByRole",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "DailyAbsenceRecord": {
      "title": "DailyAbsenceRecord",
      "description": "Date-keyed list of absent or on-leave teachers used for smart proxy availability checks.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 20, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "date": { "type": "string", "maxLength": 10 },
        "day": { "type": "string", "enum": ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"] },
        "absentTeacherIds": { "type": "array", "items": { "type": "string", "maxLength": 100 } },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedByEmail": { "type": "string", "format": "email", "maxLength": 160 },
        "updatedByName": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "date", "day", "absentTeacherIds", "updatedAt", "updatedByEmail", "updatedByName"]
    },
    "AnnualSubjectPlan": {
      "title": "AnnualSubjectPlan",
      "description": "Class-wise annual subject class count, completion tracking, daily topic schedule, and lesson plan file references (zero PII).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 160, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "academicYear": { "type": "string", "minLength": 1, "maxLength": 40 },
        "classId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "subjectId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "totalClassesPlanned": { "type": "integer", "minimum": 1, "maximum": 500 },
        "completedClasses": { "type": "integer", "minimum": 0, "maximum": 500 },
        "topics": { "type": "array" },
        "fileRefs": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedByUid": { "type": "string", "maxLength": 128 },
        "updatedByName": { "type": "string", "minLength": 1, "maxLength": 100 }
      },
      "required": [
        "id",
        "academicYear",
        "classId",
        "subjectId",
        "totalClassesPlanned",
        "completedClasses",
        "topics",
        "fileRefs",
        "updatedAt",
        "updatedByUid",
        "updatedByName"
      ]
    },
    "LessonPlanFile": {
      "title": "LessonPlanFile",
      "description": "Uploaded Word/PDF/Excel lesson plan file payload linked to an AnnualSubjectPlan (zero PII).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 160, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "planId": { "type": "string", "maxLength": 160, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "classId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "subjectId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "fileName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "mimeType": {
          "type": "string",
          "enum": [
            "application/pdf",
            "application/msword",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            "application/vnd.ms-excel",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
          ]
        },
        "fileSize": { "type": "integer", "minimum": 1, "maximum": 600000 },
        "dataBase64": { "type": "string", "minLength": 1, "maxLength": 820000 },
        "uploadedAt": { "type": "string", "format": "date-time" },
        "uploadedByUid": { "type": "string", "maxLength": 128 },
        "uploadedByName": { "type": "string", "minLength": 1, "maxLength": 100 }
      },
      "required": [
        "id",
        "planId",
        "classId",
        "subjectId",
        "fileName",
        "mimeType",
        "fileSize",
        "dataBase64",
        "uploadedAt",
        "uploadedByUid",
        "uploadedByName"
      ]
    },
    "ConnectionCheck": {
      "title": "ConnectionCheck",
      "description": "Read-only connection health check document.",
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        }
      }
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminAccount" },
      "description": "Approved admins with active/paused/blocked status controlled by Super Admin."
    },
    "/routine_public/metadata": {
      "schema": { "$ref": "#/entities/RoutineMetadata" },
      "description": "Publicly readable school routine metadata without teacher PII."
    },
    "/routine_public/schedule": {
      "schema": { "$ref": "#/entities/RoutineSchedule" },
      "description": "Publicly readable school timetable entries."
    },
    "/routine_private/staff_contacts": {
      "schema": { "$ref": "#/entities/StaffContactsDoc" },
      "description": "Protected teacher email and phone directory accessible only to active admins and Super Admin."
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLogEntry" },
      "description": "Append-only audit trail of routine and RBAC changes."
    },
    "/proxy_logs/{logId}": {
      "schema": { "$ref": "#/entities/ProxyLogEntry" },
      "description": "Protected proxy class assignment log & report records accessible only to active admins and Super Admin."
    },
    "/daily_absences/{dateId}": {
      "schema": { "$ref": "#/entities/DailyAbsenceRecord" },
      "description": "Protected daily absent teacher records keyed by YYYY-MM-DD accessible only to active admins and Super Admin."
    },
    "/annual_plans/{planId}": {
      "schema": { "$ref": "#/entities/AnnualSubjectPlan" },
      "description": "Class-wise annual subject progress, daily topics, and lesson plan file metadata (zero PII)."
    },
    "/lesson_plan_files/{fileId}": {
      "schema": { "$ref": "#/entities/LessonPlanFile" },
      "description": "Word/PDF/Excel lesson plan documents stored individually per file ID and linked from annual_plans."
    },
    "/test/{docId}": {
      "schema": { "$ref": "#/entities/ConnectionCheck" },
      "description": "Firestore connectivity probe."
    }
  }
}
