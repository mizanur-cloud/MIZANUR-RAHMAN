rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Deny all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Identity & Validation Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 160 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email.size() <= 160
        && request.auth.token.email_verified == true;
    }

    function currentEmail() {
      return request.auth.token.email.lower();
    }

    function currentEmailKey() {
      return request.auth.token.email.lower()
        .replace('@', '-at-')
        .replace('[.]', '-dot-')
        .replace('[^a-z0-9_-]', '-');
    }

    // Bootstrapped Super Admin (zero DB lookups; safe inside list rules)
    function isSuperAdmin() {
      return isVerifiedUser() && currentEmail() == 'ratan.mizan@gmail.com';
    }

    // Active Admin check (enforces existence, role == 'admin', and status == 'active')
    function isActiveAdmin() {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/admins/$(currentEmailKey()))
        && get(/databases/$(database)/documents/admins/$(currentEmailKey())).data.role == 'admin'
        && get(/databases/$(database)/documents/admins/$(currentEmailKey())).data.status == 'active';
    }

    function canEditRoutine() {
      return isSuperAdmin() || isActiveAdmin();
    }

    // 3. Entity Validation Blueprints (Anti-Update-Gap)
    function isValidAdminAccount(data) {
      return data.keys().hasAll([
          'id', 'email', 'name', 'role', 'status', 'createdAt', 'updatedAt', 'createdByEmail'
        ])
        && data.keys().hasOnly([
          'id', 'email', 'name', 'designation', 'role', 'status', 'statusReason',
          'uid', 'createdAt', 'updatedAt', 'createdByEmail', 'lastLoginAt'
        ])
        && isValidId(data.id)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.email == data.email.lower()
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && (!('designation' in data) || (data.designation is string && data.designation.size() <= 100))
        && data.role == 'admin'
        && data.status in ['active', 'paused', 'blocked']
        && (!('statusReason' in data) || (data.statusReason is string && data.statusReason.size() <= 300))
        && (!('uid' in data) || (data.uid is string && data.uid.size() <= 128))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdByEmail is string && data.createdByEmail.size() >= 3 && data.createdByEmail.size() <= 160
        && (!('lastLoginAt' in data) || data.lastLoginAt is timestamp);
    }

    function isValidRoutineMetadata(data) {
      return data.keys().hasAll([
          'classes', 'teachers', 'subjects', 'settings', 'updatedAt', 'updatedByEmail', 'updatedByName'
        ])
        && data.keys().hasOnly([
          'classes', 'teachers', 'subjects', 'settings', 'updatedAt', 'updatedByEmail', 'updatedByName'
        ])
        && data.classes is list && data.classes.size() <= 30
        && (data.classes.size() == 0 || data.classes[0] is map)
        && data.teachers is list && data.teachers.size() <= 200
        && (data.teachers.size() == 0 || data.teachers[0] is map)
        && data.subjects is list && data.subjects.size() <= 100
        && (data.subjects.size() == 0 || data.subjects[0] is map)
        && data.settings is map
        && data.updatedAt is timestamp
        && data.updatedByEmail is string && data.updatedByEmail.size() >= 3 && data.updatedByEmail.size() <= 160
        && data.updatedByName is string && data.updatedByName.size() >= 1 && data.updatedByName.size() <= 100;
    }

    function isValidRoutineSchedule(data) {
      return data.keys().hasAll([
          'entries', 'updatedAt', 'updatedByEmail', 'updatedByName'
        ])
        && data.keys().hasOnly([
          'entries', 'updatedAt', 'updatedByEmail', 'updatedByName'
        ])
        && data.entries is list && data.entries.size() <= 4000
        && (data.entries.size() == 0 || data.entries[0] is map)
        && data.updatedAt is timestamp
        && data.updatedByEmail is string && data.updatedByEmail.size() >= 3 && data.updatedByEmail.size() <= 160
        && data.updatedByName is string && data.updatedByName.size() >= 1 && data.updatedByName.size() <= 100;
    }

    function isValidStaffContacts(data) {
      return data.keys().hasAll(['contacts', 'updatedAt', 'updatedByEmail'])
        && data.keys().hasOnly(['contacts', 'updatedAt', 'updatedByEmail'])
        && data.contacts is map
        && data.updatedAt is timestamp
        && data.updatedByEmail is string && data.updatedByEmail.size() >= 3 && data.updatedByEmail.size() <= 160;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll([
          'id', 'action', 'targetSummary', 'actorEmail', 'actorName', 'actorRole', 'timestamp'
        ])
        && data.keys().hasOnly([
          'id', 'action', 'targetSummary', 'actorEmail', 'actorName', 'actorRole', 'timestamp'
        ])
        && isValidId(data.id)
        && data.action in [
          'routine_update',
          'routine_generate',
          'routine_autofix',
          'routine_import',
          'routine_reset',
          'class_update',
          'teacher_update',
          'subject_update',
          'settings_update',
          'annual_plan_update',
          'proxy_assigned',
          'proxy_updated',
          'proxy_deleted',
          'admin_added',
          'admin_paused',
          'admin_blocked',
          'admin_activated',
          'admin_removed'
        ]
        && data.targetSummary is string && data.targetSummary.size() >= 1 && data.targetSummary.size() <= 400
        && data.actorEmail is string && data.actorEmail.size() >= 3 && data.actorEmail.size() <= 160
        && data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 100
        && data.actorRole in ['super_admin', 'admin']
        && data.timestamp is timestamp;
    }

    function isValidProxyLog(data) {
      return data.keys().hasAll([
          'id', 'date', 'day', 'periodIndex', 'periodLabel', 'periodTime',
          'classId', 'className', 'sectionId', 'sectionName',
          'subjectId', 'subjectName', 'absentTeacherId', 'absentTeacherName',
          'proxyTeacherId', 'proxyTeacherName', 'assignedByEmail',
          'assignedByName', 'assignedByRole', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'date', 'day', 'periodIndex', 'periodLabel', 'periodTime',
          'classId', 'className', 'sectionId', 'sectionName',
          'subjectId', 'subjectName', 'subjectColor',
          'absentTeacherId', 'absentTeacherName',
          'proxyTeacherId', 'proxyTeacherName',
          'assignedByEmail', 'assignedByName', 'assignedByRole',
          'status', 'room', 'matchType', 'matchReason', 'overriddenWarning',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.day in ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday']
        && data.periodIndex is int && data.periodIndex >= 1 && data.periodIndex <= 12
        && data.periodLabel is string && data.periodLabel.size() >= 1 && data.periodLabel.size() <= 60
        && data.periodTime is string && data.periodTime.size() <= 60
        && data.classId is string && data.classId.size() >= 1 && data.classId.size() <= 100
        && data.className is string && data.className.size() >= 1 && data.className.size() <= 100
        && data.sectionId is string && data.sectionId.size() >= 1 && data.sectionId.size() <= 100
        && data.sectionName is string && data.sectionName.size() >= 1 && data.sectionName.size() <= 100
        && data.subjectId is string && data.subjectId.size() >= 1 && data.subjectId.size() <= 100
        && data.subjectName is string && data.subjectName.size() >= 1 && data.subjectName.size() <= 120
        && (!('subjectColor' in data) || (data.subjectColor is string && data.subjectColor.size() <= 30))
        && data.absentTeacherId is string && data.absentTeacherId.size() <= 100
        && data.absentTeacherName is string && data.absentTeacherName.size() >= 1 && data.absentTeacherName.size() <= 120
        && data.proxyTeacherId is string && data.proxyTeacherId.size() >= 1 && data.proxyTeacherId.size() <= 100
        && data.proxyTeacherName is string && data.proxyTeacherName.size() >= 1 && data.proxyTeacherName.size() <= 120
        && data.assignedByEmail is string && data.assignedByEmail.size() >= 3 && data.assignedByEmail.size() <= 160
        && data.assignedByName is string && data.assignedByName.size() >= 1 && data.assignedByName.size() <= 100
        && data.assignedByRole in ['super_admin', 'admin']
        && data.status in ['assigned', 'completed', 'cancelled']
        && (!('room' in data) || (data.room is string && data.room.size() <= 80))
        && (!('matchType' in data) || data.matchType in ['same_subject', 'same_department', 'free_teacher', 'manual'])
        && (!('matchReason' in data) || (data.matchReason is string && data.matchReason.size() <= 200))
        && (!('overriddenWarning' in data) || (data.overriddenWarning is string && data.overriddenWarning.size() <= 400))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDailyAbsence(data) {
      return data.keys().hasAll([
          'id', 'date', 'day', 'absentTeacherIds', 'updatedAt', 'updatedByEmail', 'updatedByName'
        ])
        && data.keys().hasOnly([
          'id', 'date', 'day', 'absentTeacherIds', 'updatedAt', 'updatedByEmail', 'updatedByName'
        ])
        && data.id is string && data.id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.date == data.id
        && data.day in ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday']
        && data.absentTeacherIds is list && data.absentTeacherIds.size() <= 200
        && data.updatedAt is timestamp
        && data.updatedByEmail is string && data.updatedByEmail.size() >= 3 && data.updatedByEmail.size() <= 160
        && data.updatedByName is string && data.updatedByName.size() >= 1 && data.updatedByName.size() <= 100;
    }

    function isValidAnnualPlan(data) {
      return data.keys().hasAll([
          'id', 'academicYear', 'classId', 'subjectId',
          'totalClassesPlanned', 'completedClasses', 'topics', 'fileRefs',
          'updatedAt', 'updatedByUid', 'updatedByName'
        ])
        && data.keys().hasOnly([
          'id', 'academicYear', 'classId', 'subjectId',
          'totalClassesPlanned', 'completedClasses', 'topics', 'fileRefs',
          'updatedAt', 'updatedByUid', 'updatedByName'
        ])
        && isValidId(data.id)
        && data.academicYear is string && data.academicYear.size() >= 1 && data.academicYear.size() <= 40
        && data.classId is string && data.classId.size() >= 1 && data.classId.size() <= 100
        && data.subjectId is string && data.subjectId.size() >= 1 && data.subjectId.size() <= 100
        && data.totalClassesPlanned is int && data.totalClassesPlanned >= 1 && data.totalClassesPlanned <= 500
        && data.completedClasses is int && data.completedClasses >= 0 && data.completedClasses <= 500
        && data.topics is list && data.topics.size() <= 350
        && (data.topics.size() == 0 || data.topics[0] is map)
        && data.fileRefs is list && data.fileRefs.size() <= 15
        && (data.fileRefs.size() == 0 || data.fileRefs[0] is map)
        && data.updatedAt is timestamp
        && data.updatedByUid is string && data.updatedByUid.size() >= 1 && data.updatedByUid.size() <= 128
        && data.updatedByName is string && data.updatedByName.size() >= 1 && data.updatedByName.size() <= 100;
    }

    function isValidLessonPlanFile(data) {
      return data.keys().hasAll([
          'id', 'planId', 'classId', 'subjectId', 'fileName',
          'mimeType', 'fileSize', 'dataBase64', 'uploadedAt', 'uploadedByUid', 'uploadedByName'
        ])
        && data.keys().hasOnly([
          'id', 'planId', 'classId', 'subjectId', 'fileName',
          'mimeType', 'fileSize', 'dataBase64', 'uploadedAt', 'uploadedByUid', 'uploadedByName'
        ])
        && isValidId(data.id)
        && isValidId(data.planId)
        && data.classId is string && data.classId.size() >= 1 && data.classId.size() <= 100
        && data.subjectId is string && data.subjectId.size() >= 1 && data.subjectId.size() <= 100
        && data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 160
        && data.mimeType in [
          'application/pdf',
          'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'application/vnd.ms-excel',
          'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
        ]
        && data.fileSize is int && data.fileSize >= 1 && data.fileSize <= 600000
        && data.dataBase64 is string && data.dataBase64.size() >= 1 && data.dataBase64.size() <= 820000
        && data.uploadedAt is timestamp
        && data.uploadedByUid is string && data.uploadedByUid.size() >= 1 && data.uploadedByUid.size() <= 128
        && data.uploadedByName is string && data.uploadedByName.size() >= 1 && data.uploadedByName.size() <= 100;
    }

    // 4. Collection Match Blocks
    match /admins/{adminId} {
      // Single-doc get: Super Admin OR the verified user checking their own admin record
      allow get: if isValidId(adminId) && (
        isSuperAdmin() || (isVerifiedUser() && adminId == currentEmailKey())
      );

      // List all admins: strictly Super Admin only (0 get/exists calls)
      allow list: if isSuperAdmin();

      // Create admin: strictly Super Admin only
      allow create: if isSignedIn()
        && isValidId(adminId)
        && isValidAdminAccount(incoming())
        && incoming().id == adminId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isSuperAdmin()
        && incoming().createdByEmail == currentEmail();

      // Update admin:
      // Tier 1: Super Admin can change status (active/paused/blocked), statusReason, name, designation
      // Tier 2: Active Admin can only record their own uid & lastLoginAt on login
      allow update: if isSignedIn() && isValidId(adminId) && isValidAdminAccount(incoming()) && (
        (
          incoming().id == existing().id
          && incoming().email == existing().email
          && incoming().role == existing().role
          && incoming().createdAt == existing().createdAt
          && incoming().createdByEmail == existing().createdByEmail
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'status', 'statusReason', 'name', 'designation', 'updatedAt'
          ])
          && isSuperAdmin()
        )
        ||
        (
          isVerifiedUser()
          && adminId == currentEmailKey()
          && existing().status == 'active'
          && incoming().id == existing().id
          && incoming().email == existing().email
          && incoming().role == existing().role
          && incoming().status == existing().status
          && incoming().name == existing().name
          && incoming().createdAt == existing().createdAt
          && incoming().createdByEmail == existing().createdByEmail
          && incoming().uid == request.auth.uid
          && incoming().lastLoginAt == request.time
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'uid', 'lastLoginAt', 'updatedAt'
          ])
        )
      );

      // Delete admin: strictly Super Admin only
      allow delete: if isValidId(adminId) && isSuperAdmin();
    }

    // Published routine metadata (classes, subjects, settings, public teachers without PII)
    match /routine_public/metadata {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn()
        && isValidRoutineMetadata(incoming())
        && incoming().updatedAt == request.time
        && isVerifiedUser()
        && incoming().updatedByEmail == currentEmail()
        && canEditRoutine();
      allow update: if isSignedIn()
        && isValidRoutineMetadata(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'classes', 'teachers', 'subjects', 'settings', 'updatedAt', 'updatedByEmail', 'updatedByName'
        ])
        && isVerifiedUser()
        && incoming().updatedByEmail == currentEmail()
        && canEditRoutine();
      allow delete: if false;
    }

    // Published routine schedule entries
    match /routine_public/schedule {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn()
        && isValidRoutineSchedule(incoming())
        && incoming().updatedAt == request.time
        && isVerifiedUser()
        && incoming().updatedByEmail == currentEmail()
        && canEditRoutine();
      allow update: if isSignedIn()
        && isValidRoutineSchedule(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'entries', 'updatedAt', 'updatedByEmail', 'updatedByName'
        ])
        && isVerifiedUser()
        && incoming().updatedByEmail == currentEmail()
        && canEditRoutine();
      allow delete: if false;
    }

    // Private teacher contact directory (emails & phone numbers)
    match /routine_private/staff_contacts {
      allow get: if canEditRoutine();
      allow list: if false;
      allow create: if isSignedIn()
        && isValidStaffContacts(incoming())
        && incoming().updatedAt == request.time
        && isVerifiedUser()
        && incoming().updatedByEmail == currentEmail()
        && canEditRoutine();
      allow update: if isSignedIn()
        && isValidStaffContacts(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'contacts', 'updatedAt', 'updatedByEmail'
        ])
        && isVerifiedUser()
        && incoming().updatedByEmail == currentEmail()
        && canEditRoutine();
      allow delete: if false;
    }

    // Immutable Audit & Security Activity Logs
    match /audit_logs/{logId} {
      allow get: if isValidId(logId) && isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isSignedIn()
        && isValidId(logId)
        && isValidAuditLog(incoming())
        && incoming().id == logId
        && incoming().timestamp == request.time
        && isVerifiedUser()
        && incoming().actorEmail == currentEmail()
        && canEditRoutine()
        && ((isSuperAdmin() && incoming().actorRole == 'super_admin')
          || (!isSuperAdmin() && incoming().actorRole == 'admin'));
      allow update, delete: if false;
    }

    // Protected Proxy Assignment Logs & Reports (Super Admin + Active Admin only)
    match /proxy_logs/{logId} {
      allow get: if isValidId(logId) && canEditRoutine();
      allow list: if canEditRoutine();
      allow create: if isSignedIn()
        && isValidId(logId)
        && isValidProxyLog(incoming())
        && incoming().id == logId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isVerifiedUser()
        && incoming().assignedByEmail == currentEmail()
        && canEditRoutine()
        && ((isSuperAdmin() && incoming().assignedByRole == 'super_admin')
          || (!isSuperAdmin() && incoming().assignedByRole == 'admin'));
      allow update: if isSignedIn()
        && isValidId(logId)
        && isValidProxyLog(incoming())
        && incoming().id == existing().id
        && incoming().date == existing().date
        && incoming().createdAt == existing().createdAt
        && incoming().assignedByEmail == existing().assignedByEmail
        && incoming().assignedByRole == existing().assignedByRole
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'proxyTeacherId', 'proxyTeacherName', 'status', 'matchType',
          'matchReason', 'overriddenWarning', 'absentTeacherId', 'absentTeacherName',
          'room', 'updatedAt'
        ])
        && isVerifiedUser()
        && canEditRoutine();
      allow delete: if isValidId(logId) && canEditRoutine();
    }

    // Protected Daily Absent Teacher Records (Super Admin + Active Admin only)
    match /daily_absences/{dateId} {
      allow get: if isValidId(dateId) && canEditRoutine();
      allow list: if canEditRoutine();
      allow create: if isSignedIn()
        && isValidId(dateId)
        && isValidDailyAbsence(incoming())
        && incoming().id == dateId
        && incoming().updatedAt == request.time
        && isVerifiedUser()
        && incoming().updatedByEmail == currentEmail()
        && canEditRoutine();
      allow update: if isSignedIn()
        && isValidId(dateId)
        && isValidDailyAbsence(incoming())
        && incoming().id == existing().id
        && incoming().date == existing().date
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'day', 'absentTeacherIds', 'updatedAt', 'updatedByEmail', 'updatedByName'
        ])
        && isVerifiedUser()
        && incoming().updatedByEmail == currentEmail()
        && canEditRoutine();
      allow delete: if isValidId(dateId) && canEditRoutine();
    }

    // Annual Class-wise Subject Tracker & Topic Schedule (zero PII; non-sensitive academic syllabus)
    match /annual_plans/{planId} {
      allow get: if isValidId(planId);
      allow list: if true;
      allow create: if isSignedIn()
        && isValidId(planId)
        && isValidAnnualPlan(incoming())
        && incoming().id == planId
        && incoming().updatedAt == request.time
        && incoming().updatedByUid == request.auth.uid
        && isVerifiedUser()
        && canEditRoutine();
      allow update: if isSignedIn()
        && isValidId(planId)
        && isValidAnnualPlan(incoming())
        && incoming().id == existing().id
        && incoming().academicYear == existing().academicYear
        && incoming().classId == existing().classId
        && incoming().subjectId == existing().subjectId
        && incoming().updatedAt == request.time
        && incoming().updatedByUid == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'totalClassesPlanned', 'completedClasses', 'topics', 'fileRefs',
          'updatedAt', 'updatedByUid', 'updatedByName'
        ])
        && isVerifiedUser()
        && canEditRoutine();
      allow delete: if isValidId(planId) && canEditRoutine();
    }

    // Lesson Plan Files (Word / PDF / Excel) — fetched individually by exact fileId; bulk list disabled
    match /lesson_plan_files/{fileId} {
      allow get: if isValidId(fileId);
      allow list: if false;
      allow create: if isSignedIn()
        && isValidId(fileId)
        && isValidLessonPlanFile(incoming())
        && incoming().id == fileId
        && incoming().uploadedAt == request.time
        && incoming().uploadedByUid == request.auth.uid
        && isVerifiedUser()
        && canEditRoutine()
        && exists(/databases/$(database)/documents/annual_plans/$(incoming().planId));
      allow update: if false;
      allow delete: if isValidId(fileId) && canEditRoutine();
    }

    // Firestore connectivity check document
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }
  }
}
